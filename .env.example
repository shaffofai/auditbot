# ShaffofAI audit bot — copy to .env, fill in, chmod 600 .env.
# Never commit .env; never paste these values into a chat.

# Image tag CI published (sha-<commit>); `latest` moves, a sha does not.
TAG=latest

# --- Telegram --------------------------------------------------------------
# From @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Which chats may use the bot, and which get alerts, is decided in the
# dashboard (Telegram bot tab), not here.
# Only if the server reaches Telegram through a proxy. Set HTTPS_PROXY only:
# HTTP_PROXY would also send the bot's calls to gateway/tender-v2 through it.
# HTTPS_PROXY=http://proxy.example:3128

# --- Platform audit API (audit_logs) -----------------------------------------
# The bot's OWN government account with is_admin (create it in the dashboard).
PLATFORM_URL=http://gateway:8000
PLATFORM_USERNAME=audit-bot
PLATFORM_PASSWORD=

# --- tender-v2 journal (sorov_jurnali) ----------------------------------------
# The same pair as JURNAL_LOGIN / JURNAL_PAROL in ~/shaffofai-tender-v2/.env.
# Leave both empty to export and watch the platform only.
TENDER_URL=http://tender-v2:8000
JURNAL_LOGIN=
JURNAL_PAROL=

# --- Alerts ---------------------------------------------------------------------
# Seconds between two looks at the platform's new rows (0 = no alerts at all).
ALERT_INTERVAL_SECONDS=30
# tender-v2 records each look as a journal row of its own, so it is asked less often.
ALERT_TENDER_INTERVAL_SECONDS=60
# The same alert again within this many seconds is counted, not repeated.
ALERT_WINDOW_SECONDS=600
# Failed sign-ins of one account within the window that make an alert.
ALERT_FAILED_LOGINS=5
# Browser script errors (js.error, console.error): 1 = alert, 0 = only in exports.
ALERT_BROWSER_ERRORS=1
ALERT_MAX_PER_MINUTE=15

# --- Exports ----------------------------------------------------------------------
# Rows per source in one export; a longer range is cut and the summary says so.
EXPORT_MAX_ROWS=20000
# With `tanalar`, request/response bodies are fetched for this many rows.
EXPORT_MAX_BODIES=300
# Display time zone, hours from UTC (Tashkent = 5).
TZ_OFFSET_HOURS=5
